{
  "info": {
    "name": "HireAI - Forgot & Reset Password Flow",
    "_postman_id": "78c3e89b-a12f-45a5-b8e9-forgotpassword",
    "description": "Postman Collection for testing HireAI Forgot Password and Reset Password API workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. (Optional) Register Test User",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Mohit\",\n  \"lastName\": \"User\",\n  \"email\": \"mohit.test@hireai.io\",\n  \"password\": \"OldPassword@123\",\n  \"phoneNumber\": \"9876543210\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/register/candidate",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "register", "candidate"]
        }
      }
    },
    {
      "name": "2. Forgot Password (Generate Token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mohit.test@hireai.io\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/forgot-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "forgot-password"]
        }
      }
    },
    {
      "name": "3. Verify Reset Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/auth/verify-reset-token?token={{RESET_TOKEN}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "verify-reset-token"],
          "query": [
            { "key": "token", "value": "PASTE_TOKEN_HERE_FROM_STEP_2" }
          ]
        }
      }
    },
    {
      "name": "4. Reset Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"PASTE_TOKEN_HERE_FROM_STEP_2\",\n  \"newPassword\": \"NewPassword@123\",\n  \"confirmPassword\": \"NewPassword@123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/reset-password",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "reset-password"]
        }
      }
    },
    {
      "name": "5. Login with Old Password (Should Fail 401)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mohit.test@hireai.io\",\n  \"password\": \"OldPassword@123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "6. Login with New Password (Should Succeed 200)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mohit.test@hireai.io\",\n  \"password\": \"NewPassword@123\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "login"]
        }
      }
    }
  ]
}
